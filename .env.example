# Copy to .env and adjust. Never commit .env (it is gitignored).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/flakytestpi
APP_ENV=local
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:5173
# Minimum executions before a test can be classified (INTSUFFICIENT_DATA below this).
MIN_SAMPLE_SIZE=5
# 0-100 flakiness score thresholds.
FLAKY_SCORE_THRESHOLD=40
HIGHLY_FLAKY_SCORE_THRESHOLD=70
# Seconds above which a test counts as slow (slow != flaky).
SLOW_TEST_THRESHOLD=5
